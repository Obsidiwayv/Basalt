@name "Testing"
@ThirdParty "Libs"
@RCFile "test-resource.rc"
@AppVersion "1.0"

@BundleId "space.wayvlyte.testing"
@Icon "ico/tl.icns"
@MinimumMacOSVersion "13.0"

UseClang()
CreateBinary(executable)

Sources {
  "Source/Main.cc"
  "Source/TestHeader.cc"
}
Includes {
  "Headers"
}
Assets {
  "TestAssets"
}
Win32Flags {
  "-DDEBUG=ENABLE"
}
Using {
  "TestLib/Build.lava"
  "TestLibC/Build.lava"
}
